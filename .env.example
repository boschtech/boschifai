APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): send the session cookie over HTTPS only.
# SESSION_SECURE_COOKIE=true
# Hosts the Vue app is served from, if different from APP_URL (comma-separated, with port).
# Without this, sign-in succeeds but API calls return 401.
# SANCTUM_STATEFUL_DOMAINS=localhost:8420

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest Claude-invoking Job's own $timeout (currently 1900s, see
# RunCodeGenerationJob) — otherwise the `database` queue driver considers a still-legitimately-
# running job "lost" after this many seconds and makes it available for another worker to pick
# up, causing duplicate processing of the same run step. Confirmed as a real gap, not
# theoretical: this was left at Laravel's own default (90s) despite job timeouts already
# exceeding it.
DB_QUEUE_RETRY_AFTER=3600

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing email (invitations, password resets). `log` writes messages to
# storage/logs/laravel.log instead of sending them. For real delivery use Amazon SES:
#   MAIL_MAILER=ses, MAIL_FROM_ADDRESS = an address on a domain verified in SES, SES_REGION =
#   the region it's verified in. On AWS leave SES_ACCESS_KEY_ID/SES_SECRET_ACCESS_KEY empty so
#   the task role is used; elsewhere set them to an IAM user allowed only ses:SendRawEmail.
# Check the setup with: php artisan boschifai:send-test-email you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Boschifai — see config/boschifai.php for the full set and README.md for
# the bare-host vs. Docker workflows these apply to.
# --------------------------------------------------------------------------

# Required for headless `claude -p` invocations to authenticate (bare-host mode
# uses your already-logged-in `claude` CLI instead and can leave this blank).
# TODO: production should source this from AWS SSM, never a committed .env —
# see config/boschifai.php.
ANTHROPIC_API_KEY=

# The `claude` process only ever sees PATH, HOME, locale/proxy settings and its own
# credentials — never this file's other secrets (see ClaudeProcessHardening). Add extra
# non-secret worker variables it genuinely needs here, comma-separated.
BOSCHIFAI_CLAUDE_ENV_PASSTHROUGH=
# The only API endpoint the CLI may use (a repo's .claude/settings.json can't change it).
BOSCHIFAI_CLAUDE_API_BASE_URL=https://api.anthropic.com
# Claude Code --restricted mode (file tools confined to the checkout, no Bash). Off until a
# full pipeline run has been verified with it on.
BOSCHIFAI_CLAUDE_RESTRICTED_MODE=false

# Single-tenant features. Turn both off for any install shared between customers: the
# local-repo browser reads this host's filesystem, and the MCP push path uses one GitHub
# token (GITHUB_MCP_PAT) for every repo.
BOSCHIFAI_FEATURE_LOCAL_REPOS=true
BOSCHIFAI_FEATURE_GITHUB_MCP_PUSH=true

# "Connect Repo" → GitHub section — a classic OAuth App ("Authorized OAuth Apps"), the
# same mechanism VS Code's own "Sign in with GitHub" uses. One-time, out-of-band
# setup: an org admin registers an OAuth App at
# https://github.com/settings/applications/new (or the org equivalent) with
# Authorization callback URL {APP_URL}/github/callback — this immediately yields
# a Client ID and Client Secret, no RSA keypair needed. There's no per-repo
# permission screen for this flow (see GithubOAuthService's own doc comment) —
# access is granted user-account-wide via the `repo` scope, and which repos Boschifai
# actually acts on is chosen afterward in its own "Connect Repo" UI.
# Revoking access on GitHub's side (https://github.com/settings/applications)
# won't be detected here until the next attempted use fails (a known, accepted
# gap — no webhook receiver exists in this codebase).
BOSCHIFAI_GITHUB_OAUTH_CLIENT_ID=
# TODO: production should source this from AWS SSM, never a committed .env —
# same pattern as ANTHROPIC_API_KEY above. Unlike a GitHub App private key this
# is a plain string, but it's just as sensitive: it lets a party impersonate
# this OAuth App and phish for user authorizations.
BOSCHIFAI_GITHUB_OAUTH_CLIENT_SECRET=

# Optional — enables PushAndOpenPrJob's GitHub-MCP-based push path (see config/boschifai.php's
# github_mcp docblock). Leave blank to keep using the original deterministic git-push + REST API
# flow. A fine-grained Personal Access Token belonging to whatever account should perform pushes
# and open PRs on Boschifai's behalf — that account needs push + PR permissions on every
# connected repo. TODO: production should source this from AWS SSM, never a committed .env —
# same pattern as ANTHROPIC_API_KEY above.
GITHUB_MCP_PAT=

# "Connect Repo" → Local Repository section — the ONE directory LocalRepoController is allowed
# to browse/mirror repos from (every path is checked against this root — see
# config/boschifai.php's `local_repos` docblock for why, given this app has no authentication).
# Bare-host: point this directly at wherever your repo checkouts live.
BOSCHIFAI_LOCAL_REPOS_ROOT_PATH=/path/to/your/projects
# Docker only: the HOST path bind-mounted to BOSCHIFAI_LOCAL_REPOS_ROOT_PATH's container-internal
# default (/host-repos) — see docker-compose.yml. Not read by Laravel itself.
BOSCHIFAI_LOCAL_REPOS_ROOT=/path/to/your/projects

# Prepaid credits. Every Claude step is priced and recorded. BILLING_ENFORCE=false (shadow mode)
# charges and blocks nothing; true holds each step's credits first and pauses runs that can't
# pay (see README "Credits"). The figures are pricing decisions for finance (USD); unset =
# priced at cost, no minimum, no hold. Calibrate with `php artisan boschifai:billing-report`.
BILLING_ENFORCE=false
BILLING_MARKUP=
BILLING_MIN_CHARGE_USD=
BILLING_HOLD_GAP_ANALYSIS_USD=
BILLING_HOLD_TEST_PLAN_USD=
BILLING_HOLD_TEST_CASE_GENERATION_USD=
BILLING_HOLD_CODE_GENERATION_USD=
BILLING_HOLD_FIX_FAILING_TESTS_USD=
BILLING_HOLD_PUSH_USD=
BILLING_HOLD_BUILD_SKILLS_USD=
BILLING_HOLD_BUILD_KNOWLEDGE_BASE_USD=
# Credit packs customers can buy, "key:credits:price" in USD (docs/outstanding-decisions.md D5).
BILLING_PACKS=

# Payment providers to offer, e.g. "stripe,payfast" (only implemented ones are used — D1). Provider
# secrets go in their own variables / AWS SSM, never in the repo.
PAYMENTS_ENABLED=
# Exchange rate for providers that charge in ZAR: price × rate × (1 + buffer) (D3).
PAYMENTS_FX_ZAR_RATE=
PAYMENTS_FX_ZAR_BUFFER=0

# Encrypts workspaces' own AI provider keys (Settings → AI provider) — separate from APP_KEY.
# Generate with `php artisan boschifai:generate-credentials-key`; production: AWS SSM. Back it up.
# Rotation: new key here, old one in BOSCHIFAI_CREDENTIALS_PREVIOUS_KEYS, then
# `php artisan boschifai:rotate-credentials-key`.
BOSCHIFAI_CREDENTIALS_KEY=
BOSCHIFAI_CREDENTIALS_PREVIOUS_KEYS=

# Amazon Bedrock on customers' own AWS accounts: the AWS identity the app/worker run as (e.g. the
# ECS task role ARN), allowed sts:AssumeRole. Unset = the Bedrock option isn't offered.
BOSCHIFAI_BEDROCK_PRINCIPAL_ARN=
