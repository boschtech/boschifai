# Runtime sandbox — mirror clones, per-run worktrees, and Claude transcripts. These contain
# a live checkout of the target repo and potentially requirement text; never source-controlled.
# The whole directory is ignored (not just /var/boschifai) since its entire purpose is ephemeral
# runtime output regardless of naming.
/var

/.fleet
/.idea
/.nova
/.vscode
/.zed

# OS/editor cruft
.DS_Store
Thumbs.db

# Rust build artifacts from docker/boschifai-cli (bare-host `cargo build`) — regenerated on
# every build, and can run into the hundreds of MB.
target/
